{
  "name": "dsh-qzone-echo",
  "version": "0.4.0",
  "type": "module",
  "description": "DSH 插件：把你自己 QQ 空间发过的说说收进本地库，分出「个人思考 / 感想」「梦记」「介绍/推荐」「已删除」四栏；已删除的用 tid 逐条验活精确判定",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nineoooo/dsh-qzone-echo.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "qzone",
    "qq-zone",
    "archive",
    "memory"
  ],
  "bugs": {
    "url": "https://github.com/nineoooo/dsh-qzone-echo/issues"
  },
  "homepage": "https://github.com/nineoooo/dsh-qzone-echo#readme",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
